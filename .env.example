# Copy this file to `.env` (in the project root) and fill in real values.
# `.env` is git-ignored — never commit real secrets.
#
# Generate strong secrets with:  openssl rand -hex 32

# ─── Backend (FastAPI) ───────────────────────────────────────────────────────
KYRO_JWT_SECRET=change-me-openssl-rand-hex-32
KYRO_API_KEY=change-me-openssl-rand-hex-32
KYRO_JWT_EXPIRY_HOURS=24

# Dashboard admin fallback account (only used if no DB user exists).
KYRO_DASHBOARD_USER=admin
KYRO_DASHBOARD_PASS=change-me-strong-password

# Login rate-limit (per IP): max attempts per window (seconds).
KYRO_LOGIN_RATE_MAX_HITS=10
KYRO_LOGIN_RATE_WINDOW_S=60

# CORS: comma-separated origins allowed to call the API.
# Example: https://kyro.kharischurch.com,https://staging.kyro.kharischurch.com
ALLOWED_ORIGINS=

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=kyro
POSTGRES_USER=kyro
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://kyro:change-me-strong-password@postgres:5432/kyro

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
# Generate a pair with:
#   pip install pywebpush && python -c "from pywebpush import Vapid; v=Vapid(); v.generate_keys(); print(v.public_key_pem().decode()); print(v.private_key_pem().decode())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain

# ─── Vision worker ───────────────────────────────────────────────────────────
DETECTION_DEVICE=cpu
CAMERA_ID=cam-01
STREAM_SOURCE=/dev/video0
